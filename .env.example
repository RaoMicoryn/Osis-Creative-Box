# --- Database (Neon / PostgreSQL) ---
DATABASE_URL=postgresql://user:password@localhost:5432/osis_aspirasi

# --- Admin ---
# Password untuk login di /admin/login (dibagikan ke pengurus OSIS & Pembina)
ADMIN_PASSWORD=
# Kunci penanda cookie sesi admin (acak panjang): openssl rand -hex 32
SESSION_SECRET=
# Opsional: akses lewat curl/Postman dengan header  Authorization: Bearer <ADMIN_API_KEY>
# Kosongkan jika tidak dipakai.  Buat acak panjang: openssl rand -hex 32
ADMIN_API_KEY=

# --- Rate limit pengiriman Creative Box ---
# Rahasia untuk meng-HMAC IP sebelum disimpan (WAJIB diganti di produksi): openssl rand -hex 32
RATE_LIMIT_SECRET=
CB_RATE_LIMIT=5
CB_RATE_WINDOW_MINUTES=15
